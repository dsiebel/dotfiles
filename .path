# ------------------------------------------------------------------------ $PATH

# ZSH seems to load `/etc/profile` which runs eval `/usr/libexec/path_helper -s`
# which messes with $PATH.
# The global /etc/profile gets sourced after `.zshenv` and before `.zprofile`.
# This is why we set up $PATH in here, instead of `.zshenv` where it belongs.

# User ${HOME} bin
export PATH="${HOME}/bin:${HOME}/.bin"

# Golang $GOPATH bin
export PATH="${PATH}:${GOPATH}/bin"

# Cargo
export PATH="${PATH}:${HOME}/.cargo/bin"

# homebrew
export PATH="${PATH}:${HOMEBREW_PREFIX}/bin:${HOMEBREW_PREFIX}/sbin:/usr/local/bin"

# GNU Tools
export PATH="${PATH}:${HOMEBREW_PREFIX}/opt/make/libexec/gnubin"
export PATH="${PATH}:${HOMEBREW_PREFIX}/opt/curl/bin"
export PATH="${PATH}:${HOMEBREW_PREFIX}/opt/gnu-sed/libexec/gnubin"

# Google Cloud SDK
export PATH="${PATH}:${HOMEBREW_PREFIX}/share/google-cloud-sdk/bin"

# asdf version manager
export PATH="${PATH}:${HOMEBREW_PREFIX}/opt/asdf/libexec/bin"

# Volta
export PATH="${PATH}:${HOME}/.volta/bin"

# krew - kubectl plugin manager
export PATH="${PATH}:${KREW_ROOT}/bin"

# Rancher Desktop
export PATH="${PATH}:/.rd/bin"

# Original macos path
export PATH="${PATH}:/usr/bin:/usr/sbin:/bin:/sbin"
export PATH="${PATH}:/usr/local/MacGPG2/bin"
export PATH="${PATH}:/Applications/Wireshark.app/Contents/MacOS"
