{
	"diffEditor.ignoreTrimWhitespace": false,
	"editor.renderWhitespace": "all",
	"editor.rulers": [
		80,
		120
	],
	"editor.fontFamily": "FiraCode Nerd Font Mono, Fira Code, Noto Mono, Menlo, Monaco, monospace",
	"editor.fontLigatures": true,
	"editor.renderLineHighlight": "gutter",
	"explorer.openEditors.visible": 0,
	"files.associations": {
		"*.sls": "yaml",
		"*.job": "terraform",
		"*.tftpl": "terraform",
		"Makefile.*": "makefile",
		"*.docker": "dockerfile",
		"*.hcl": "hcl"
	},
	"files.autoSave": "onFocusChange",
	"todohighlight.keywords": [/*
		{
			"text": "TODO",
			//"color": "#082149",
			"backgroundColor": "#eaf2ff",
			"isWholeLine": true
		},
		{
			"text": "FIXME",
			//"color": "#630a56",
			"backgroundColor": "#ffedfc",
			"isWholeLine": true
		},
		{
			"text": "NOTE",
			//"color": "#725609",
			"backgroundColor": "#fff8e5",
			"isWholeLine": true
		}
	*/
],
	"workbench.startupEditor": "none",
	"workbench.editor.openSideBySideDirection": "down",
	"extensions.ignoreRecommendations": false,
	"[plaintext]": {},
	"workbench.editor.closeEmptyGroups": false,
	"workbench.editor.highlightModifiedTabs": true,
	"php.suggest.basic": false,
	"breadcrumbs.enabled": true,
	"shellcheck.run": "onSave",
	"workbench.colorCustomizations": {
		"terminal.foreground": "#EFEFEF",
		"terminal.background": "#1E1E1E",
		"terminal.ansiBlack": "#000000",
		"terminal.ansiBrightBlack": "#686966",
		"terminal.ansiRed": "#c6341b",
		"terminal.ansiBrightRed": "#e15140",
		"terminal.ansiGreen": "#6fa430",
		"terminal.ansiBrightGreen": "#a9e15d",
		"terminal.ansiYellow": "#c9ae38",
		"terminal.ansiBrightYellow": "#f9eb77",
		"terminal.ansiBlue": "#4f78ae",
		"terminal.ansiBrightBlue": "#8caed4",
		"terminal.ansiMagenta": "#83668b",
		"terminal.ansiBrightMagenta": "#b595b4",
		"terminal.ansiCyan": "#46a4a8",
		"terminal.ansiBrightCyan": "#73e2e6",
		"terminal.ansiWhite": "#dbded8",
		"terminal.ansiBrightWhite": "#f1f1ef",
	},
	"terminal.external.osxExec": "iTerm.app",
	"terminal.integrated.rightClickBehavior": "default",
	"terminal.integrated.scrollback": 10000,
	"editor.renderControlCharacters": true,
	"[terraform]": {
		"editor.defaultFormatter": "hashicorp.terraform",
		"editor.formatOnSave": true,
		"editor.formatOnSaveMode": "file"
	},
	"[terraform-vars]": {
		"editor.defaultFormatter": "hashicorp.terraform",
		"editor.formatOnSave": true,
		"editor.formatOnSaveMode": "file"
	},
	"git.showPushSuccessNotification": true,
	"git.suggestSmartCommit": false,
	"search.collapseResults": "auto",
	"window.openFoldersInNewWindow": "on",
	"terminal.integrated.copyOnSelection": true,
	"editor.minimap.enabled": true,
	"todo-tree.general.tags": [
		"BUG",
		"HACK",
		"FIXME",
		"TODO",
		"XXX",
		"[ ]",
		"[x]"
	],
	"todo-tree.regex.regex": "(//|#|<!--|;|/\\*|^|^\\s*(-|\\d+.))\\s*($TAGS)",
	"go.toolsManagement.autoUpdate": true,
	"redhat.telemetry.enabled": false,
	"terminal.integrated.profiles.windows": {
		"Git Bash": {
			"source": "Git Bash"
		}
	},
	"terminal.integrated.profiles.linux": {
		"bash": {
			"path": "bash",
			"icon": "terminal-bash"
		},
		"zsh": {
			"path": "zsh"
		},
		"fish": {
			"path": "fish"
		},
		"tmux": {
			"path": "tmux",
			"icon": "terminal-tmux"
		},
		"pwsh": {
			"path": "pwsh",
			"icon": "terminal-powershell"
		}
	},
	"git.confirmSync": false,
	"security.workspace.trust.untrustedFiles": "open",
	"yaml.completion": false,
	"terminal.integrated.persistentSessionScrollback": 10000,
	"extensions.supportUntrustedWorkspaces": {

	},
	"yaml.schemas": {



		"https://coderabbit.ai/integrations/schema.v2.json": [
			"*.coderabbit.yaml"
		],
		"https://squidfunk.github.io/mkdocs-material/schema.json": [
			"mkdocs.yaml",
			"mkdocs.yml"
		],
		"file:///Users/dsiebel/workspace/source/metafold/src/config/v4/schema.json": [
			"metafold.yaml",
			"!.github/workflows/metafold.yaml"
		]
	},
	"json.schemas": [
		{
			"fileMatch": ["release-please-config.json"],
			"url": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json"
		}
	],
	"update.mode": "start",
	"vs-kubernetes": {
		"vs-kubernetes.crd-code-completion": "disabled",
		"vscode-kubernetes.kubectl-path-mac": "/Users/dsiebel/.vs-kubernetes/tools/kubectl/kubectl",
		"vscode-kubernetes.minikube-path-mac": "/Users/dsiebel/.vs-kubernetes/tools/minikube/darwin-arm64/minikube",
		"vs-kubernetes.minikube-show-information-expiration": "2026-11-14T12:55:45.330Z"
	},
	"markdown.extension.toc.unorderedList.marker": "*",
	"markdown.extension.toc.omittedFromToc": {

		"*": ["# ", "## Table of Contents"]
	},
	"markdown.extension.toc.levels": "2..6",
	"dev.containers.defaultExtensions": [
		"skellock.just",
		"EditorConfig.EditorConfig",
		"yzhang.markdown-all-in-one",
		"timonwong.shellcheck",
		"wayou.vscode-todo-highlight",
		"redhat.vscode-yaml",
		" eamodio.gitlens"
	],
	"git.enableCommitSigning": true,
	"githubPullRequests.pullBranch": "never",
	"gitlens.codeLens.recentChange.enabled": false,
	"gitlens.codeLens.authors.enabled": false,
	"githubPullRequests.terminalLinksHandler": "github",
	"git.rebaseWhenSync": true,
	"editor.suggest.selectionMode": "never",
	"editor.action.inlineSuggest.trigger": "Ctrl+Shift+Space",
	"github.copilot.enable": {
		"*": true,
		"plaintext": true,
		"markdown": true,
		"scminput": false
	},
	"workbench.colorTheme": "Light+",
	"workbench.preferredDarkColorTheme": "Dark+",
	"workbench.preferredLightColorTheme": "Light+",
	"githubPullRequests.createOnPublishBranch": "never",
	"githubPullRequests.defaultMergeMethod": "squash",
	"github.copilot.advanced": {
	},
	"terminal.integrated.localEchoStyle": "dim",
	"terminal.integrated.minimumContrastRatio": 1,
	"github.copilot.editor.enableAutoCompletions": true,
	"ansible.validation.lint.enabled": false,
	"window.autoDetectColorScheme": true,
	"diffEditor.experimental.useTrueInlineView": true,
	"yaml.format.printWidth": 120,
	"git.openRepositoryInParentFolders": "never",
	"remote.SSH.configFile": "~/.ssh/config.d/vscode",
	"workbench.iconTheme": "material-icon-theme",
	"workbench.tree.indent": 10,
